---
const apiUrl = "http://127.0.0.1:8000";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Vehicles - Admin Panel</title>
	</head>

	<body>
		<header class="topbar">
			<div>
				<a href="/" class="back">← Dashboard</a>
				<p class="eyebrow">MANAGEMENT</p>
				<h1>Vehicles</h1>
				<p class="muted">Vehicle models registered in Neddex.</p>
			</div>

			<button id="add-vehicle" class="primary-button" type="button">
				+ Add Vehicle
			</button>
		</header>

		<main>
			<section class="toolbar">
				<div class="search-wrapper">
					<label for="search">Search</label>
					<input
						id="search"
						type="search"
						placeholder="Search manufacturer or model..."
						autocomplete="off"
					/>
				</div>

				<div class="filter-wrapper">
					<label for="enabled-filter">Enabled</label>
					<select id="enabled-filter">
						<option value="">All</option>
						<option value="true">Enabled</option>
						<option value="false">Disabled</option>
					</select>
				</div>

				<div class="filter-wrapper">
					<label for="spawn-filter">Spawn Eligible</label>
					<select id="spawn-filter">
						<option value="">All</option>
						<option value="true">Eligible</option>
						<option value="false">Excluded</option>
					</select>
				</div>
			</section>

			<div class="status-row">
				<div id="status" class="status">Loading vehicles...</div>
			</div>

			<section class="table-wrapper">
				<table>
					<thead>
						<tr>
							<th>ID</th>
							<th>Manufacturer</th>
							<th>Model</th>
							<th>Year</th>
							<th>Rarity</th>
							<th>Enabled</th>
							<th>Spawn</th>
							<th>Limited</th>
							<th>Mint</th>
							<th>Actions</th>
						</tr>
					</thead>

					<tbody id="vehicle-table">
						<tr>
							<td colspan="10" class="loading">
								Loading vehicles...
							</td>
						</tr>
					</tbody>
				</table>
			</section>

			<section id="empty-state" class="empty hidden">
				<h2>No vehicles found</h2>
				<p>Try changing your search or filters.</p>
			</section>

			<nav class="pagination" aria-label="Vehicle pagination">
				<button id="previous-page" type="button">
					← Previous
				</button>

				<span id="page-info">Page 1 of 1</span>

				<button id="next-page" type="button">
					Next →
				</button>
			</nav>
		</main>

		<script define:vars={{ apiUrl }}>
			const status = document.querySelector("#status");
			const table = document.querySelector("#vehicle-table");
			const emptyState = document.querySelector("#empty-state");

			const searchInput = document.querySelector("#search");
			const enabledFilter = document.querySelector("#enabled-filter");
			const spawnFilter = document.querySelector("#spawn-filter");

			const previousButton = document.querySelector("#previous-page");
			const nextButton = document.querySelector("#next-page");
			const pageInfo = document.querySelector("#page-info");
			const addVehicleButton = document.querySelector("#add-vehicle");

			const pageSize = 50;

			let currentPage = 1;
			let totalPages = 0;
			let searchTimeout;

			async function loadVehicles() {
				status.textContent = "Loading vehicles...";
				status.className = "status";

				table.innerHTML = `
					<tr>
						<td colspan="10" class="loading">
							Loading vehicles...
						</td>
					</tr>
				`;

				emptyState.classList.add("hidden");

				const params = new URLSearchParams();

				params.set("page", String(currentPage));
				params.set("page_size", String(pageSize));

				const search = searchInput.value.trim();

				if (search) {
					params.set("search", search);
				}

				const enabled = enabledFilter.value;

				if (enabled) {
					params.set("enabled", enabled);
				}

				const spawnEligible = spawnFilter.value;

				if (spawnEligible) {
					params.set("spawn_eligible", spawnEligible);
				}

				try {
					const response = await fetch(
						`${apiUrl}/admin/vehicles?${params.toString()}`,
					);

					if (!response.ok) {
						throw new Error(`API returned ${response.status}`);
					}

					const data = await response.json();

					currentPage = data.page;
					totalPages = data.total_pages;

					status.textContent = `${data.total.toLocaleString()} vehicle model${data.total === 1 ? "" : "s"}`;

					pageInfo.textContent =
						totalPages === 0
							? "Page 0 of 0"
							: `Page ${currentPage} of ${totalPages}`;

					previousButton.disabled =
						currentPage <= 1 || totalPages === 0;

					nextButton.disabled =
						currentPage >= totalPages || totalPages === 0;

					if (data.items.length === 0) {
						table.innerHTML = "";
						emptyState.classList.remove("hidden");
						return;
					}

					table.innerHTML = data.items
						.map(
							(vehicle) => `
								<tr>
									<td class="id-cell">${vehicle.id}</td>

									<td>
										<span class="manufacturer">
											${escapeHtml(vehicle.manufacturer)}
										</span>
									</td>

									<td class="model-cell">
										${escapeHtml(vehicle.model_name)}
									</td>

									<td>${vehicle.year ?? "—"}</td>

									<td>${vehicle.rarity_weight}</td>

									<td>
										<span class="badge ${vehicle.enabled ? "enabled" : "disabled"}">
											${vehicle.enabled ? "Enabled" : "Disabled"}
										</span>
									</td>

									<td>
										<span class="badge ${vehicle.spawn_eligible ? "enabled" : "disabled"}">
											${vehicle.spawn_eligible ? "Yes" : "No"}
										</span>
									</td>

									<td>
										${vehicle.limited ? "Yes" : "No"}
									</td>

									<td>
										${vehicle.limited
											? `${vehicle.highest_mint} / ${vehicle.mint_limit}`
											: vehicle.highest_mint}
									</td>

									<td>
										<div class="actions">
											<button
												type="button"
												class="action-button"
												data-action="edit"
												data-id="${vehicle.id}"
											>
												Edit
											</button>

											<button
												type="button"
												class="action-button danger"
												data-action="delete"
												data-id="${vehicle.id}"
											>
												Delete
											</button>
										</div>
									</td>
								</tr>
							`,
						)
						.join("");
				} catch (error) {
					console.error(error);

					status.textContent =
						"Unable to connect to the Admin API.";
					status.className = "status error";

					table.innerHTML = `
						<tr>
							<td colspan="10" class="loading error-text">
								Unable to load vehicles.
							</td>
						</tr>
					`;
				}
			}

			function escapeHtml(value) {
				return String(value)
					.replaceAll("&", "&amp;")
					.replaceAll("<", "&lt;")
					.replaceAll(">", "&gt;")
					.replaceAll('"', "&quot;")
					.replaceAll("'", "&#039;");
			}

			searchInput.addEventListener("input", () => {
				clearTimeout(searchTimeout);

				searchTimeout = setTimeout(() => {
					currentPage = 1;
					loadVehicles();
				}, 300);
			});

			enabledFilter.addEventListener("change", () => {
				currentPage = 1;
				loadVehicles();
			});

			spawnFilter.addEventListener("change", () => {
				currentPage = 1;
				loadVehicles();
			});

			previousButton.addEventListener("click", () => {
				if (currentPage <= 1) {
					return;
				}

				currentPage -= 1;
				loadVehicles();
			});

			nextButton.addEventListener("click", () => {
				if (currentPage >= totalPages) {
					return;
				}

				currentPage += 1;
				loadVehicles();
			});

			addVehicleButton.addEventListener("click", () => {
                window.location.href = "/vehicles/new";
            });

			table.addEventListener("click", async (event) => {
				const button = event.target.closest("button[data-action]");

				if (!button) {
					return;
				}

				const action = button.dataset.action;
				const vehicleId = button.dataset.id;

				if (action === "edit") {
					window.location.href = `/vehicles/${vehicleId}/edit`;
                    return;
				}

				if (action === "delete") {
                    const confirmed = window.confirm(
                        `Delete Vehicle ${vehicleId}? This cannot be undone.`
                );

                if (!confirmed) {
                    return;
                }

                try {
                    const response = await fetch(
                        `${apiUrl}/admin/vehicles/${vehicleId}`,
                        {
                            method: "DELETE",
                        },
                    );

                    if (response.status === 409) {
                        const data = await response.json();

                        status.textContent =
                            data.detail || "This vehicle cannot be deleted.";
                        status.className = "status error";

                        return;
                    }

                    if (response.status === 404) {
                        status.textContent = "Vehicle no longer exists.";
                        status.className = "status error";

                        await loadVehicles();

                        return;
                    }

                    if (!response.ok) {
                        throw new Error(`API returned ${response.status}`);
                    }

                    status.textContent = `Vehicle ${vehicleId} deleted.`;
                    status.className = "status";

                    await loadVehicles();
                } catch (error) {
                    console.error(error);

                    status.textContent =
                        "Unable to delete vehicle.";
                    status.className = "status error";
                }
            }
			});

			loadVehicles();
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		background: #0b0d10;
		color: #f5f7fa;
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}

	.topbar {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid #20242a;
		padding: 32px 48px;
	}

	main {
		max-width: 1500px;
		margin: 0 auto;
		padding: 32px 48px 48px;
	}

	.back {
		display: inline-block;
		margin-bottom: 28px;
		color: #8b939e;
		font-size: 14px;
		text-decoration: none;
	}

	.back:hover {
		color: #f5f7fa;
	}

	.eyebrow {
		margin: 0 0 6px;
		color: #7f8792;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	h1,
	h2,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 8px;
		font-size: 30px;
	}

	h2 {
		margin-bottom: 8px;
		font-size: 20px;
	}

	.muted {
		margin-bottom: 0;
		color: #8b939e;
	}

	.primary-button {
		border: 1px solid #f5f7fa;
		border-radius: 8px;
		background: #f5f7fa;
		padding: 10px 16px;
		color: #0b0d10;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
	}

	.primary-button:hover {
		opacity: 0.9;
	}

	.toolbar {
		display: flex;
		align-items: flex-end;
		gap: 16px;
		margin-bottom: 20px;
	}

	.search-wrapper {
		flex: 1;
		min-width: 240px;
	}

	.filter-wrapper {
		width: 170px;
	}

	label {
		display: block;
		margin-bottom: 7px;
		color: #7f8792;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	input,
	select {
		width: 100%;
		border: 1px solid #292e35;
		border-radius: 7px;
		outline: none;
		background: #111419;
		color: #f5f7fa;
		font: inherit;
		font-size: 13px;
	}

	input {
		padding: 11px 12px;
	}

	select {
		padding: 10px 12px;
	}

	input:focus,
	select:focus {
		border-color: #59616c;
	}

	.status-row {
		min-height: 24px;
	}

	.status {
		margin-bottom: 12px;
		color: #8b939e;
		font-size: 13px;
	}

	.status.error,
	.error-text {
		color: #ff7b7b;
	}

	.table-wrapper {
		overflow-x: auto;
		border: 1px solid #20242a;
		border-radius: 10px;
		background: #111419;
	}

	table {
		width: 100%;
		min-width: 950px;
		border-collapse: collapse;
	}

	th {
		border-bottom: 1px solid #292e35;
		background: #0f1216;
		color: #707985;
		font-size: 10px;
		font-weight: 700;
		text-align: left;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}

	th,
	td {
		padding: 13px 14px;
	}

	td {
		border-bottom: 1px solid #1d2127;
		color: #c8cdd3;
		font-size: 13px;
		white-space: nowrap;
	}

	tbody tr:last-child td {
		border-bottom: 0;
	}

	tbody tr:hover {
		background: #15191e;
	}

	.id-cell {
		color: #707985;
		font-variant-numeric: tabular-nums;
	}

	.manufacturer {
		color: #8b939e;
	}

	.model-cell {
		color: #f5f7fa;
		font-weight: 600;
	}

	.badge {
		display: inline-block;
		border: 1px solid #30363e;
		border-radius: 999px;
		padding: 4px 8px;
		color: #9ba3ad;
		font-size: 10px;
		font-weight: 700;
	}

	.badge.enabled {
		border-color: #3a4540;
		color: #aab9b0;
	}

	.badge.disabled {
		color: #777f89;
	}

	.actions {
		display: flex;
		gap: 6px;
	}

	.action-button {
		border: 1px solid #30363e;
		border-radius: 6px;
		background: transparent;
		padding: 6px 9px;
		color: #b7bec7;
		font: inherit;
		font-size: 11px;
		cursor: pointer;
	}

	.action-button:hover {
		background: #1a1f25;
		color: #f5f7fa;
	}

	.action-button.danger:hover {
		border-color: #5b3838;
		color: #ff8f8f;
	}

	.loading {
		padding: 36px;
		color: #707985;
		text-align: center;
	}

	.empty {
		margin-top: 16px;
		border: 1px solid #20242a;
		border-radius: 10px;
		background: #111419;
		padding: 40px;
		text-align: center;
	}

	.empty p {
		margin-bottom: 0;
		color: #707985;
	}

	.hidden {
		display: none;
	}

	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		margin-top: 20px;
	}

	.pagination button {
		border: 1px solid #30363e;
		border-radius: 7px;
		background: #111419;
		padding: 8px 12px;
		color: #b7bec7;
		font: inherit;
		font-size: 12px;
		cursor: pointer;
	}

	.pagination button:hover:not(:disabled) {
		background: #1a1f25;
		color: #f5f7fa;
	}

	.pagination button:disabled {
		cursor: not-allowed;
		opacity: 0.35;
	}

	#page-info {
		min-width: 100px;
		color: #8b939e;
		font-size: 12px;
		text-align: center;
	}

	@media (max-width: 700px) {
		.topbar {
			align-items: flex-start;
			flex-direction: column;
			padding: 24px;
		}

		main {
			padding: 24px;
		}

		.primary-button {
			width: 100%;
		}

		.toolbar {
			align-items: stretch;
			flex-direction: column;
		}

		.search-wrapper,
		.filter-wrapper {
			width: 100%;
		}

		.table-wrapper {
			margin-right: -24px;
			margin-left: -24px;
			border-right: 0;
			border-left: 0;
			border-radius: 0;
		}

		.pagination {
			justify-content: space-between;
		}
	}
</style>